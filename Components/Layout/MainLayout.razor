@inherits LayoutComponentBase

<main class="min-h-screen w-full">
    @Body
</main>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 w-full z-[1000] bg-[#ffffe0] px-5 py-3 pt-[0.6rem] pb-[0.7rem] shadow-[0_-1px_2px_rgba(0,0,0,0.2)]">
    An unhandled error has occurred.
    <a href="" class="underline font-semibold ml-1">Reload</a>
    <span class="dismiss absolute right-3 top-2 cursor-pointer text-gray-500 hover:text-gray-800">🗙</span>
</div>